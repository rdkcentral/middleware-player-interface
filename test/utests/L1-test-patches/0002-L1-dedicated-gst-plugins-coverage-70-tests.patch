+
+TEST_F(GstPluginL1Tests, ViperTransform_OtherEventKeepsState)
+{
+	GstViperTransform *el = GST_VIPERTRANSFORM(g_object_new(GST_TYPE_VIPERTRANSFORM, NULL));
+	el->m_content_type = ViperContentType::LINEAR_OFFSET;
+	el->m_linear_begin_offset = 77;
