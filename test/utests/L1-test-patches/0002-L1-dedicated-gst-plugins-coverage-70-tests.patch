+/* ================================================================== */
+/* GstViperTransform - transform (non-harmonic)                         */
+/* ================================================================== */
+
+TEST_F(GstPluginL1Tests, ViperTransform_TransformCopiesPayload)
+{
+	GstBaseTransform *trans = GST_BASE_TRANSFORM(g_object_new(GST_TYPE_VIPERTRANSFORM, NULL));
+	const char *doc = "<?xml version=\"1.0\"?><tt><body/></tt>";
+	GstBuffer *inbuf = MakeBuffer(doc, strlen(doc));
+	GstBuffer *outbuf = gst_buffer_new_and_alloc(strlen(doc));
+
+	GstFlowReturn rc = ClassOf(trans)->transform(trans, inbuf, outbuf);
+	EXPECT_EQ(rc, GST_FLOW_OK);
+	EXPECT_EQ(BufferToString(outbuf), doc);
+
+	gst_buffer_unref(inbuf);
+	gst_buffer_unref(outbuf);
+	gst_object_unref(trans);
+}
+
+TEST_F(GstPluginL1Tests, ViperTransform_TransformAppliesLinearOffset)
+{
+	GstViperTransform *el = GST_VIPERTRANSFORM(g_object_new(GST_TYPE_VIPERTRANSFORM, NULL));
+	el->m_linear_begin_offset = 2500;
+	const char *doc = "<?xml version=\"1.0\"?><tt><body/></tt>";
+	GstBuffer *inbuf = MakeBuffer(doc, strlen(doc));
+	GstBuffer *outbuf = gst_buffer_new_and_alloc(strlen(doc));
+
+	GstFlowReturn rc = ClassOf(GST_BASE_TRANSFORM(el))->transform(GST_BASE_TRANSFORM(el), inbuf, outbuf);
+	EXPECT_EQ(rc, GST_FLOW_OK);
+	EXPECT_EQ(GST_BUFFER_OFFSET(outbuf), 2500);
+
+	gst_buffer_unref(inbuf);
+	gst_buffer_unref(outbuf);
+	gst_object_unref(el);
+}
+
+TEST_F(GstPluginL1Tests, ViperTransform_TransformNoOffsetLeavesBufferOffset)
+{
