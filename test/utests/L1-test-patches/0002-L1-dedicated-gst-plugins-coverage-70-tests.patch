+TEST_F(GstPluginL1Tests, Mp4Transform_IpMdatExtractsPayload)
+{
+	GstBaseTransform *trans = GST_BASE_TRANSFORM(g_object_new(GST_TYPE_SUBTECMP4TRANSFORM, NULL));
+	std::vector<uint8_t> doc{'<', 't', 't', '/', '>'};
+	std::vector<uint8_t> payload;
+	AppendBox(payload, "mdat", doc);
+	// findBoxOffsetAndLength returns boxLength = boxSize INCLUDING the 8-byte
+	// box header, so transform_ip copies boxSize bytes from the payload start:
+	// it always over-reads 8 bytes past the mdat payload.  A trailing 'free'
+	// box keeps the over-read inside the buffer and makes the output
+	// deterministic: payload + the 8-byte free-box header.
+	AppendBox(payload, "free", {});
+	GstBuffer *buf = MakeBuffer(payload.data(), payload.size());
+
+	GstFlowReturn rc = ClassOf(trans)->transform_ip(trans, buf);
+	EXPECT_EQ(rc, GST_FLOW_OK);
+	EXPECT_EQ(gst_buffer_get_size(buf), doc.size() + 8);
+	std::vector<uint8_t> expected = doc;
+	const uint8_t freeHdr[8] = {0x00, 0x00, 0x00, 0x08, 'f', 'r', 'e', 'e'};
+	expected.insert(expected.end(), freeHdr, freeHdr + 8);
+	EXPECT_EQ(BufferToString(buf),
+			  std::string(reinterpret_cast<const char *>(expected.data()), expected.size()));
+	gst_buffer_unref(buf);
+	gst_object_unref(trans);
+}
